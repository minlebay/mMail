{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Окно настроек: оформление, ящики, хранилище и своё окно. Читать почту не может.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "allow-set-calendar-view",
    "allow-set-title-buttons",
    "allow-set-window-pin",
    "allow-window-pins",
    "allow-context-menu-items",
    "allow-google-status",
    "allow-google-connect",
    "allow-google-disconnect",
    "allow-get-appearance",
    "allow-set-appearance",
    "allow-list-accounts",
    "allow-add-account",
    "allow-remove-account",
    "allow-storage-info",
    "allow-set-body-days",
    "allow-clear-cache",
    "allow-set-show-all-accounts",
    "allow-set-notifications",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-current-monitor",
    "core:window:allow-set-size-constraints",
    "core:app:allow-version"
  ]
}
