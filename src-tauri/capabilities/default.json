{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно: чтение ящика через команды ядра и управление своим окном.",
  "windows": ["main"],
  "permissions": [
    "allow-list-folders",
    "allow-list-messages",
    "allow-get-message",
    "allow-set-sender-trusted",
    "allow-get-appearance",
    "allow-set-appearance",
    "allow-set-zoom",
    "allow-save-attachment",
    "allow-open-link",
    "allow-sync-status",
    "allow-list-accounts",
    "allow-add-account",
    "allow-remove-account",
    "allow-unlock-store",
    "allow-open-compose",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-is-maximized",
    "core:window:allow-close"
  ]
}
