{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно: чтение ящика через команды ядра и управление своим окном.",
  "windows": ["main"],
  "permissions": [
    "allow-context-menu-items",
    "allow-list-folders",
    "allow-write-clipboard",
    "allow-mark-message-read",
    "allow-mark-folder-read",
    "allow-set-message-flags",
    "allow-trash-message",
    "allow-message-translation-text",
    "allow-translate-text",
    "allow-list-messages",
    "allow-get-message",
    "allow-set-sender-trusted",
    "allow-get-appearance",
    "allow-set-zoom",
    "allow-save-attachment",
    "allow-open-link",
    "allow-sync-status",
    "allow-unlock-store",
    "allow-open-compose",
    "allow-open-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-is-maximized",
    "core:window:allow-close"
  ]
}
