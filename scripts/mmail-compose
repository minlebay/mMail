#!/usr/bin/env bash
# Открыть в работающем mMail окно нового письма с заполненными полями. Письмо НЕ отправляется:
# проверить и нажать «Отправить» должен человек.
#
#   scripts/mmail-compose --from me@gmail.com --to someone@example.com --subject "Тема" \
#     --attach отчёт.pdf --attach фото.jpg <<'TEXT'
#   Текст письма
#   TEXT
#
# Текст — из stdin (или --body "…"). --from — один из ящиков mMail; иначе будет первый ящик.
# --attach можно повторять; всего до 25 МБ.
# Если mMail не запущен, он запускается (scripts/launch.sh), и окно открывается после старта.
set -euo pipefail

NAME=dev.minlebay.mmail.SingleInstance
OBJECT=/dev/minlebay/mmail/SingleInstance

args=(mmail compose)
body=
has_body=
while (($#)); do
  case "$1" in
    --from|--to|--subject) (($# >= 2)) || { echo "нет значения для $1" >&2; exit 2; }; args+=("$1" "$2"); shift 2 ;;
    --attach)
      (($# >= 2)) || { echo "нет значения для --attach" >&2; exit 2; }
      [[ -f $2 ]] || { echo "нет файла: $2" >&2; exit 2; }
      args+=(--attach "$(readlink -f -- "$2")"); shift 2 ;;
    --body) (($# >= 2)) || { echo "нет значения для --body" >&2; exit 2; }; body=$2; has_body=1; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "неизвестный параметр: $1" >&2; exit 2 ;;
  esac
done
if [[ -z $has_body && ! -t 0 ]]; then
  body=$(cat)
fi
[[ -n $body ]] && args+=(--body "$body")

running() { busctl --user status "$NAME" >/dev/null 2>&1; }

if ! running; then
  setsid "$(dirname "$(readlink -f "$0")")/launch.sh" >/dev/null 2>&1 < /dev/null &
  for _ in $(seq 180); do running && break; sleep 1; done
  running || { echo "mMail не запустился" >&2; exit 1; }
  sleep 3 # ящики подключаются после старта окна
fi

busctl --user call -- "$NAME" "$OBJECT" org.SingleInstance.DBus ExecuteCallback ass "${#args[@]}" "${args[@]}" "$PWD" >/dev/null
echo "Окно письма открыто в mMail — проверьте и нажмите «Отправить»."
